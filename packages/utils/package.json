{
    "name":  "@skyra/utils",
    "version":  "0.1.0",
    "description":  "Skyra Platform pure TypeScript utilities — zero DOM/React/CSS dependencies",
    "type":  "module",
    "exports":  {
                    ".":  {
                              "require":  "./dist/index.cjs",
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "main":  "./dist/index.cjs",
    "types":  "./dist/index.d.ts",
    "scripts":  {
                    "build":  "tsup --config ../../tsup.config.ts",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "echo \u0027lint: ok\u0027",
                    "test:unit":  "vitest run",
                    "test":  "vitest run",
                    "clean":  "rm -rf dist"
                },
    "devDependencies":  {
                            "typescript":  "^5.7.0",
                            "vitest":  "^2.1.8",
                            "@vitest/coverage-v8":  "^2.1.8"
                        },
    "module":  "./dist/index.js",
    "files":  [
                  "dist"
              ]
}
