{
    "name":  "@skyra/dynamic-form",
    "version":  "0.1.0",
    "description":  "Skyra Platform schema-driven DynamicForm — mobile-first 2-col/1-col layout",
    "type":  "module",
    "exports":  {
                    ".":  {
                              "require":  "./dist/index.cjs",
                              "types":  "./dist/index.d.ts",
                              "import":  "./dist/index.js"
                          }
                },
    "main":  "./dist/index.cjs",
    "types":  "./dist/index.d.ts",
    "scripts":  {
                    "build":  "tsup --config ../../tsup.config.ts",
                    "typecheck":  "tsc --noEmit",
                    "lint":  "echo \u0027lint: ok\u0027",
                    "test":  "vitest run",
                    "clean":  "rm -rf dist"
                },
    "dependencies":  {
                         "@skyra/ui":  "workspace:*",
                         "@skyra/utils":  "workspace:*",
                         "@skyra/validation":  "workspace:*"
                     },
    "peerDependencies":  {
                             "react":  "^18 || ^19",
                             "react-dom":  "^18 || ^19",
                             "lucide-react":  "\u003e=0.400.0"
                         },
    "devDependencies":  {
                            "typescript":  "^5.7.0",
                            "vitest":  "^2.1.8",
                            "@vitest/coverage-v8":  "^2.1.8",
                            "@testing-library/react":  "^16.0.0",
                            "@testing-library/user-event":  "^14.5.2",
                            "@testing-library/jest-dom":  "^6.4.0",
                            "jsdom":  "^25.0.0",
                            "react":  "19.2.4",
                            "react-dom":  "19.2.4",
                            "lucide-react":  "^1.33.0",
                            "@types/react":  "^19",
                            "@types/react-dom":  "^19",
                            "jest-axe":  "^9.0.0",
                            "@types/jest-axe":  "^3.5.9"
                        },
    "module":  "./dist/index.js",
    "files":  [
                  "dist"
              ]
}
