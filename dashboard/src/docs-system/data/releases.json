  "pending-app-shell-distribution-fix": {
    "id": "pending-app-shell-distribution-fix",
    "version": "Pending Release",
    "date": "2026-10-05",
    "summary": "fix(app-shell): migrate distribution architecture to tsup",
    "packages": [
      {
        "packageId": "@skyra/app-shell",
        "packageName": "@skyra/app-shell",
        "changes": [
          {
            "id": "change-xm0q6vt",
            "type": "changed",
            "title": "Migrated package build system from raw `tsc` to `tsup` to match the Platform's standard distribution architecture.",
            "breaking": false
          },
          {
            "id": "change-swc6nc5",
            "type": "changed",
            "title": "Remapped public `exports`, `main`, `module`, and `types` to target the compiled `./dist` artifacts instead of raw `./src` TypeScript files.",
            "breaking": false
          },
          {
            "id": "change-xjp6w0c",
            "type": "fixed",
            "title": "Resolved missing local `@types/react` dependencies that caused isolated build failures.",
            "breaking": false
          },
          {
            "id": "change-rlh7kqr",
            "type": "changed",
            "title": "Packages are now properly isolated, independently consumable, and fully resolvable without requiring consumers to transpile workspace source.",
            "breaking": false
          }
        ]
      }
    ]
  },
