{
  "name": "@skyra/app-shell",
  "version": "0.1.0",
  "description": "Skyra Platform reusable application shell and layout system",
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: ok'",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@skyra/design-tokens": "workspace:*",
    "@skyra/ui": "workspace:*",
    "@skyra/utils": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.8",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "lucide-react": "^1.33.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
