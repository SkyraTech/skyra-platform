{
  "name": "@skyra/ui",
  "version": "0.1.0",
  "description": "Skyra Platform reusable UI primitives — accessible and mobile-first",
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: ok'",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@skyra-tech-platform/button": "workspace:^",
    "@skyra-tech-platform/checkbox": "workspace:^",
    "@skyra-tech-platform/date-time": "workspace:^",
    "@skyra-tech-platform/dynamic-select": "workspace:^",
    "@skyra-tech-platform/input": "workspace:^",
    "@skyra-tech-platform/pdf-viewer": "workspace:^",
    "@skyra-tech-platform/radio": "workspace:^",
    "@skyra-tech-platform/switch": "workspace:^",
    "@skyra-tech-platform/textarea": "workspace:^",
    "@skyra/data-export": "workspace:*",
    "@skyra/design-tokens": "workspace:*",
    "@skyra/utils": "workspace:*",
    "pdfjs-dist": "4.10.38"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/pdfjs-dist": "^2.10.378",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^2.1.8",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "lucide-react": "^1.33.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "module": "./dist/index.js",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "publishConfig": {
    "access": "restricted"
  },
  "sideEffects": true
}
