{
  "name": "@skyra-tech-platform/app-shell",
  "version": "0.1.0",
  "description": "Skyra Platform reusable application shell and layout system",
  "type": "module",
  "exports": {
    "./styles.css": "./src/styles.css",
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: ok'",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@skyra-tech-platform/design-tokens": "workspace:*",
    "@skyra-tech-platform/utils": "workspace:*"
  },
  "peerDependencies": {},
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "restricted"
  }
}