{
  "name": "skyra-platform",
  "version": "0.0.1",
  "private": true,
  "description": "Skyra Platform — Internal reusable UI foundation and design system",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:a11y": "turbo run test:a11y",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --update-snapshots",
    "clean": "turbo run clean",
    "dashboard": "pnpm --filter dashboard dev",
    "api:update": "tsx scripts/api-governance.ts update",
    "api:check": "tsx scripts/api-governance.ts check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^2.1.9",
    "axe-playwright": "^2.2.2",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
