{
  "name": "@skyra-tech-platform/dynamic-form",
  "version": "0.1.0",
  "description": "Skyra Platform schema-driven DynamicForm — mobile-first 2-col/1-col layout",
  "type": "module",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: ok'",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@skyra-tech-platform/button": "workspace:^",
    "@skyra-tech-platform/checkbox": "workspace:^",
    "@skyra-tech-platform/date-time": "workspace:^",
    "@skyra-tech-platform/dynamic-select": "workspace:^",
    "@skyra-tech-platform/input": "workspace:^",
    "@skyra-tech-platform/radio": "workspace:^",
    "@skyra-tech-platform/switch": "workspace:^",
    "@skyra-tech-platform/textarea": "workspace:^",
    "@skyra/utils": "workspace:*",
    "@skyra/validation": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
    "@types/jest-axe": "^3.5.9",
    "@vitest/coverage-v8": "^2.1.8",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.0",
    "lucide-react": "^1.33.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}