{
  "name": "@skyra-tech-platform/popover",
  "version": "0.1.0",
  "sideEffects": true,
  "description": "Framework-agnostic anchored rich content overlay Web Component with collision detection and focus management",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "@skyra-tech-platform/design-tokens": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@skyra-tech-platform/design-tokens": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.5.1",
    "vitest": "^2.1.8",
    "jsdom": "^24.1.3",
    "@types/node": "^20.19.43",
    "@types/jsdom": "^21.1.7"
  }
}
