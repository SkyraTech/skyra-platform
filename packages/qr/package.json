{
  "name": "@skyra-tech-platform/qr",
  "version": "0.1.0",
  "description": "Skyra Platform generic QR code generation, matrix calculation, and SVG rendering",
  "exports": {
    ".": {
      "require": "./dist/core.cjs",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "main": "./dist/core.cjs",
  "types": "./dist/core.d.ts",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: ok'",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "module": "./dist/core.js",
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "restricted"
  }
}
